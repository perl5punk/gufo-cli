#!/usr/bin/env bash
#
# gufo — manage local GGUF models through Gufo (Strix Halo inference engine)
#        and hook them into pi-webui via ~/.pi/agent/models.json.
#
# Every model runs in its own podman container from the gufo-runtime image,
# serving an OpenAI-compatible API on 127.0.0.1. When registered, a provider
# named "gufo-<model-slug>" is added to pi's models.json so pi-webui (and pi)
# can pick the model up immediately (the web server re-reads models.json on
# every request — no restart needed).
#
set -euo pipefail

# ---------------------------------------------------------------- config ----
GUFO_IMAGE="${GUFO_IMAGE:-ghcr.io/gufo-org/toolboxes/gufo-runtime:latest}"
GUFO_PORT_START="${GUFO_PORT_START:-13306}"      # auto-increments if busy
GUFO_MODELS_DIRS=(
  "${GUFO_MODELS_DIR:-$HOME/models}"
  "$HOME/.local/share/gufo/models"
)
PI_MODELS_JSON="${PI_MODELS_JSON:-$HOME/.pi/agent/models.json}"
GUFO_CTX_DEFAULT=131072
# CPU-side conversation-cache budget in bytes. Keep this well below the OS-side
# RAM pool: gufo's own default (half of free RAM, up to 32 GiB) OOM'd the host
# on this machine's 32 GiB system pool while loading a 30 GB model file.
GUFO_RAM_CACHE_DEFAULT=$((4 * 1024 * 1024 * 1024)) # 4 GiB
GUFO_MAX_DEFAULT=32768
WAIT_TIMEOUT=900                                  # max seconds to wait for model load
CONTAINER_PREFIX="gufo-"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_rst=$'\033[0m'
info() { printf '%s\n' "$*" >&2; }
ok()   { printf '%s\n' "${c_grn}$*${c_rst}" >&2; }
warn() { printf '%s\n' "${c_ylw}$*${c_rst}" >&2; }
die()  { printf '%s\n' "${c_red}error: $*${c_rst}" >&2; exit 1; }

# ------------------------------------------------------------ helpers -------
slugify() {
  local s
  s=$(basename "$1" | tr '[:upper:]' '[:lower:]' | sed 's/\.gguf$//')
  s=$(printf '%s' "$s" | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//')
  s=$(printf '%s' "$s" | sed 's/-[0-9][0-9]*-of-[0-9][0-9]*$//') # multi-shard suffix
  printf '%.48s' "$s"
}

resolve_model() {
  local query="$1" f d base hit lb ql
  if [ -f "$query" ]; then
    printf '%s\n' "$(realpath "$query")"
    return 0
  fi
  base=$(basename "$query"); base="${base,,}"
  ql="${query,,}"
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
      lb="${f##*/}"
      lb_n="${lb,,}"
      lb_n="${lb_n//_/-}"
      if [ "$lb_n" = "${base//_/-}" ] || [[ "$lb_n" == *"${ql//_/-}"* ]]; then
        printf '%s\n' "$f"
        return 0
      fi
    done < <(find "$d" -maxdepth 4 -iname '*.gguf' 2>/dev/null)
  done
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    hit=$(find "$d" -maxdepth 4 -iname '*.gguf' -ipath "*$query*" 2>/dev/null | head -1)
    if [ -n "$hit" ]; then
      printf '%s\n' "$hit"
      return 0
    fi
  done
  return 1
}

# Mount root: prefer the top-level models dir so /models mirrors the host tree
mount_root_for() {
  local path="$1" d
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    case "$path" in "$d"/*) printf '%s\n' "$d"; return 0 ;; esac
  done
  dirname "$path"
}

container_path_for() { # <path> <root> -> /models/<relative>
  local path="$1" root="$2"
  printf '/models/%s' "${path#"$root"/}"
}

# Model dir: nearest ancestor of <path> that is a direct child of a models dir
# (search boundary for draft sidecars, e.g. ~/models/qwen3.8-flash-next)
model_dir_for() {
  local path="$1" d rel
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    case "$path" in
      "$d"/*)
        rel="${path#"$d"/}"
        if [[ "$rel" == */* ]]; then
          printf '%s/%s' "$d" "${rel%%/*}"
        else
          printf '%s' "$d"
        fi
        return 0 ;;
    esac
  done
  dirname "$path"
}

# First GGUF under <dir> (maxdepth 3) matching one of the name patterns, skipping <target>
find_sidecar() {
  local dir="$1" target="$2" pat f
  shift 2
  for pat in "$@"; do
    while IFS= read -r f; do
      if [ "$f" != "$target" ]; then
        printf '%s\n' "$f"
        return 0
      fi
    done < <(find "$dir" -maxdepth 3 -type f -iname "$pat" 2>/dev/null | sort)
  done
  return 1
}

free_port() {
  local p=$1
  while ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}$"; do
    p=$((p + 1))
    if [ "$p" -gt $(( $1 + 64 )) ]; then
      return 1
    fi
  done
  printf '%s\n' "$p"
}

c_name() { printf '%s%s' "$CONTAINER_PREFIX" "$(slugify "$1")"; }
provider_name() { printf '%s%s' "$CONTAINER_PREFIX" "$(slugify "$1")"; }

require_container() {
  podman inspect "$1" >/dev/null 2>&1 || die "container '$1' not found (see: gufo models / gufo status)"
}

container_running() {
  local st
  st=$(podman inspect -f '{{.State.Status}}' "$1" 2>/dev/null || echo missing)
  [ "$st" = "running" ]
}

# Port the container publishes on the host (podman port: "127.0.0.1:13306->0.0.0.0:13306")
container_host_port() {
  podman port "$1" 2>/dev/null | head -1 | awk -F'->' '{print $1}' | grep -oE '[0-9]+$' || true
}

# Device passthrough + group access, per gufo-org docs (crun/runc-safe: numeric gids)
gpu_flags() {
  local kfd_gid dri_gid dev
  GPU_FLAGS=()
  kfd_gid=$(stat -c '%g' /dev/kfd 2>/dev/null || true)
  if [ -n "$kfd_gid" ]; then
    GPU_FLAGS+=(--device /dev/kfd --group-add "$kfd_gid")
  fi
  if [ -d /dev/dri ]; then
    GPU_FLAGS+=(--device /dev/dri)
    for dev in /dev/dri/renderD*; do
      [ -e "$dev" ] || continue
      dri_gid=$(stat -c '%g' "$dev")
      if [ "$dri_gid" != "$kfd_gid" ]; then
        GPU_FLAGS+=(--group-add "$dri_gid")
      fi
    done
  fi
  GPU_FLAGS+=(--ulimit memlock=-1)
}

# -------------------------------------------------------- models.json -------
require_models_json() {
  [ -f "$PI_MODELS_JSON" ] || die "models.json not found at $PI_MODELS_JSON"
  command -v jq >/dev/null || die "jq is required to edit models.json"
}

backup_models_json() {
  require_models_json
  cp -f "$PI_MODELS_JSON" "$PI_MODELS_JSON.bak"
}

register_model() { # <provider> <baseUrl> <modelId> <displayName> <ctx> <max> [oldId]
  local prov="$1" base="$2" id="$3" name="$4" ctx="$5" max="$6" oldid="${7:-}" tmp
  require_models_json
  backup_models_json
  tmp=$(mktemp)
  jq --arg p "$prov" --arg base "$base" --arg id "$id" --arg name "$name" \
     --argjson ctx "$ctx" --argjson max "$max" --arg oldid "$oldid" '
    .providers[$p] = ((.providers[$p] // {models: []}) | {
      baseUrl: $base,
      api: "openai-completions",
      apiKey: "gufo-local",
      models: ((.models // []) | map(select(.id != $id and .id != $oldid)))
    })
    | .providers[$p].models += [{id: $id, name: $name, contextWindow: $ctx, maxTokens: $max}]
  ' "$PI_MODELS_JSON" > "$tmp"
  mv "$tmp" "$PI_MODELS_JSON"
}

unregister_model() { # <provider>
  require_models_json
  backup_models_json
  local tmp
  tmp=$(mktemp)
  jq --arg p "$1" 'del(.providers[$p])' "$PI_MODELS_JSON" > "$tmp"
  mv "$tmp" "$PI_MODELS_JSON"
}

is_registered() { # <provider>
  jq -e --arg p "$1" '.providers[$p] != null' "$PI_MODELS_JSON" >/dev/null 2>&1
}

# Canonical model id served by a running container (taken from GGUF metadata)
served_model_id() { # <port>
  curl -fsS --max-time 5 "http://127.0.0.1:$1/v1/models" 2>/dev/null | jq -r '.data[0].id // empty'
}

wait_ready() { # <name> <port>
  local name="$1" port="$2" t=0
  info "Waiting for model load (up to $((WAIT_TIMEOUT / 60)) min)..."
  while :; do
    if curl -fsS --max-time 5 "http://127.0.0.1:${port}/v1/models" >/dev/null 2>&1; then
      echo >&2
      return 0
    fi
    if ! container_running "$name"; then
      echo >&2
      warn "container exited during load — last log lines:"
      podman logs --tail 15 "$name" >&2 || true
      return 1
    fi
    t=$((t + 5))
    if [ "$t" -ge "$WAIT_TIMEOUT" ]; then
      echo >&2
      warn "timed out after ${WAIT_TIMEOUT}s — last log lines:"
      podman logs --tail 15 "$name" >&2 || true
      return 1
    fi
    printf '\r  loading... %ds   ' "$t" >&2
    sleep 5
  done
}

# --------------------------------------------------------------- commands ----
cmd_models() {
  local found=0 d f
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
      found=1
      printf '%-58s %8s  %s\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)" "$f"
    done < <(find "$d" -maxdepth 4 -iname '*.gguf' 2>/dev/null | sort)
  done
  if [ "$found" != 1 ]; then
    warn "no .gguf files found in: ${GUFO_MODELS_DIRS[*]}"
  fi
}

cmd_run() {
  local model_q="" port="" name="" image="$GUFO_IMAGE" register=1
  local ctx=$GUFO_CTX_DEFAULT max=$GUFO_MAX_DEFAULT ram_cache=$GUFO_RAM_CACHE_DEFAULT
  local spec_mode=auto spec_path="" draft_tokens="" draft_policy=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)        port="${2:-}"; shift 2 ;;
      --name)        name="${2:-}"; shift 2 ;;
      --image)       image="${2:-}"; shift 2 ;;
      --ctx)         ctx="${2:-}"; shift 2 ;;
      --max)         max="${2:-}"; shift 2 ;;
      --ram-cache)   ram_cache="${2:-}"; shift 2 ;;
      --speculative) spec_mode="${2:-}"; shift 2
                     if [ $# -gt 0 ] && [[ "$1" != -* ]]; then spec_path="$1"; shift; fi ;;
      --draft-tokens) draft_tokens="${2:-}"; shift 2 ;;
      --draft-policy) draft_policy="${2:-}"; shift 2 ;;
      --no-register) register=0; shift ;;
      -h|--help)     usage; exit 0 ;;
      -*)            die "unknown option: $1" ;;
      *)
        if [ -n "$model_q" ]; then
          die "one model per run; got '$model_q' and '$1'"
        fi
        model_q="$1"; shift ;;
    esac
  done
  if [ -z "$model_q" ]; then
    die "usage: gufo run <model> [--port N] [--ctx N] [--max N] [--ram-cache BYTES] [--speculative MODE [sidecar.gguf]] [--no-register]"
  fi
  if [[ ! "$spec_mode" =~ ^(auto|off|mtp|dflash2|dspark)$ ]]; then
    die "invalid --speculative '$spec_mode' (expected auto, off, mtp, dflash2 or dspark)"
  fi
  command -v podman >/dev/null || die "podman not found in PATH"

  local path
  path=$(resolve_model "$model_q") || die "model not found: $model_q (see: gufo models)"
  if [ -z "$name" ]; then
    name=$(c_name "$path")
  fi
  if [ -z "$port" ]; then
    port=$(free_port "$GUFO_PORT_START") || die "no free port found from $GUFO_PORT_START"
  fi
  if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"; then
    die "port $port is already in use"
  fi

  if container_running "$name"; then
    warn "container '$name' is already running (port $(container_host_port "$name"))."
    warn "Use 'gufo stop $name' first, or pick another name/port."
    exit 1
  fi
  podman rm -f "$name" >/dev/null 2>&1 || true

  local root cpath
  root=$(mount_root_for "$path")
  cpath=$(container_path_for "$path" "$root")

  # ------------------------------------------------ speculative sidecar ----
  # auto: enable the best available draft backend if a matching sidecar GGUF
  # sits in the model's dir (mtp-*.gguf > *dflash2*.gguf > *dspark*.gguf)
  local SPEC_ARGS=() sidecar="" mdir spec_label="off (AR)"
  mdir=$(model_dir_for "$path")
  pick_sidecar() { # <patterns...> -> sets sidecar (from --speculative PATH or discovery)
    if [ -n "$spec_path" ]; then
      [ -f "$spec_path" ] || die "draft sidecar not found: $spec_path"
      sidecar=$(realpath "$spec_path")
    else
      sidecar=$(find_sidecar "$mdir" "$path" "$@") || \
        die "no draft sidecar found in $mdir (patterns: $*); pass one explicitly: --speculative $spec_mode <sidecar.gguf>"
    fi
  }
  case "$spec_mode" in
    mtp)
      pick_sidecar 'mtp-*.gguf' '*mtp*.gguf'
      SPEC_ARGS+=(--speculative mtp --mtp-model "$(container_path_for "$sidecar" "$root")")
      spec_label="mtp"
      ;;
    dflash2)
      pick_sidecar '*dflash2*.gguf'
      SPEC_ARGS+=(--speculative dflash2 --dflash-model "$(container_path_for "$sidecar" "$root")")
      spec_label="dflash2"
      ;;
    dspark)
      pick_sidecar '*dspark*.gguf'
      SPEC_ARGS+=(--speculative dspark --dspark-model "$(container_path_for "$sidecar" "$root")")
      spec_label="dspark"
      ;;
    auto)
      if sidecar=$(find_sidecar "$mdir" "$path" 'mtp-*.gguf' '*mtp*.gguf'); then
        SPEC_ARGS+=(--speculative mtp --mtp-model "$(container_path_for "$sidecar" "$root")")
        spec_label="mtp (auto)"
      elif sidecar=$(find_sidecar "$mdir" "$path" '*dflash2*.gguf'); then
        SPEC_ARGS+=(--speculative dflash2 --dflash-model "$(container_path_for "$sidecar" "$root")")
        spec_label="dflash2 (auto)"
      elif sidecar=$(find_sidecar "$mdir" "$path" '*dspark*.gguf'); then
        SPEC_ARGS+=(--speculative dspark --dspark-model "$(container_path_for "$sidecar" "$root")")
        spec_label="dspark (auto)"
      else
        spec_label="off (no draft sidecar in $mdir)"
      fi
      ;;
    off) ;;
  esac
  if [ -n "$sidecar" ]; then
    case "$sidecar" in "$root"/*) : ;; *) die "draft sidecar must live under the mounted models root '$root': $sidecar" ;; esac
    spec_label="$spec_label: $sidecar"
  fi
  if [ -n "$draft_tokens" ]; then
    [[ "$draft_tokens" =~ ^[1-7]$ ]] || die "--draft-tokens must be 1-7"
    SPEC_ARGS+=(--draft-tokens "$draft_tokens")
  fi
  if [ -n "$draft_policy" ]; then
    [[ "$draft_policy" =~ ^(fixed|adaptive)$ ]] || die "--draft-policy must be fixed or adaptive"
    SPEC_ARGS+=(--draft-policy "$draft_policy")
  fi

  gpu_flags
  info "Starting $name"
  info "  model:  $path"
  info "  spec:   $spec_label"
  info "  image:  $image"
  info "  port:   127.0.0.1:$port"
  if ! podman run -d --name "$name" \
    "${GPU_FLAGS[@]}" \
    -v "${root}:/models:ro,z" \
    -p 127.0.0.1:${port}:${port} \
    "$image" \
    gufo serve llm --model "$cpath" --host 0.0.0.0 --port "$port" \
      -c "$ctx" --cache-ram-bytes "$ram_cache" "${SPEC_ARGS[@]}" >/dev/null; then
    die "podman run failed"
  fi

  wait_ready "$name" "$port" || die "model failed to load (container left running: gufo logs $name)"

  local id
  id=$(served_model_id "$port") || true
  if [ -z "$id" ]; then
    die "could not read model id from http://127.0.0.1:$port/v1/models"
  fi
  ok "ready: model id '$id' on http://127.0.0.1:$port/v1"

  if [ "$register" = 1 ]; then
    local prov display
    prov=$(provider_name "$path")
    display="$(basename "$path" .gguf) (Gufo Local)"
    register_model "$prov" "http://127.0.0.1:${port}/v1" "$id" "$display" "$ctx" "$max"
    ok "registered as provider '$prov' in $PI_MODELS_JSON (backup: .bak)"
    info "pi-webui picks it up automatically — open the model picker in your browser."
  else
    info "skipped registration (--no-register)"
  fi
}

cmd_stop() {
  local target="${1:-}" keep_config=0
  if [ "${2:-}" = "--keep-config" ]; then
    keep_config=1
  fi
  if [ -z "$target" ]; then
    die "usage: gufo stop <model|name|all> [--keep-config]"
  fi

  local names=() n
  if [ "$target" = "all" ]; then
    while IFS= read -r n; do
      if [ -n "$n" ]; then
        names+=("$n")
      fi
    done < <(podman ps -a --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}')
  else
    local name
    if [ "${target:0:5}" = "gufo-" ]; then
      name="$target" # already a container name
    else
      name=$(c_name "$target")
    fi
    require_container "$name"
    names=("$name")
  fi
  if [ "${#names[@]}" -eq 0 ]; then
    warn "no gufo containers found"
    return 0
  fi

  for n in "${names[@]}"; do
    podman stop -t 15 "$n" >/dev/null 2>&1 || true
    podman rm -f "$n" >/dev/null 2>&1 || true
    info "stopped + removed: $n"
    if [ "$keep_config" != 1 ] && [ -f "$PI_MODELS_JSON" ] && is_registered "$n"; then
      unregister_model "$n"
      info "removed provider '$n' from models.json"
    fi
  done
}

cmd_status() {
  local any=0 n st port id
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    any=1
    st=$(podman inspect -f '{{.State.Status}}' "$n" 2>/dev/null || echo missing)
    printf '%s  %s\n' "$n" "$st"
    if [ "$st" = "running" ]; then
      port=$(container_host_port "$n")
      if [ -n "$port" ]; then
        printf '    port: http://127.0.0.1:%s/v1\n' "$port"
        id=$(served_model_id "$port") || true
        if [ -n "$id" ]; then
          printf '    model: %s\n' "$id"
        fi
      fi
      if [ -f "$PI_MODELS_JSON" ] && is_registered "$n"; then
        printf '    registered in models.json: %syes%s\n' "$c_grn" "$c_rst"
      else
        printf '    registered in models.json: %sno%s\n' "$c_ylw" "$c_rst"
      fi
    fi
  done < <(podman ps -a --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}' | sort)
  if [ "$any" != 1 ]; then
    info "no gufo containers found"
  fi
}

cmd_logs() {
  local target="${1:-}" follow=1
  if [ "${2:-}" = "--no-follow" ]; then
    follow=0
  fi
  if [ -z "$target" ]; then
    local n
    n=$(podman ps -a --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}' | head -1)
    if [ -z "$n" ]; then
      die "no gufo containers found"
    fi
    target="$n"
  fi
  local name
  name=$(c_name "$target")
  require_container "$name"
  if [ "$follow" = 1 ]; then
    exec podman logs -f --tail 100 "$name"
  fi
  podman logs --tail 100 "$name"
}

cmd_prompt() {
  local model_q="" prompt="" max_tokens=256
  while [ $# -gt 0 ]; do
    case "$1" in
      --max-tokens) max_tokens="${2:-}"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      *)
        if [ -n "$model_q" ] && [ -n "$prompt" ]; then
          die "unexpected argument: $1"
        fi
        if [ -z "$model_q" ]; then
          model_q="$1"
        else
          prompt="$1"
        fi
        shift ;;
    esac
  done
  if [ -z "$model_q" ] || [ -z "$prompt" ]; then
    die "usage: gufo prompt <model> \"prompt text\" [--max-tokens N]"
  fi
  local path root cpath
  path=$(resolve_model "$model_q") || die "model not found: $model_q"
  root=$(mount_root_for "$path")
  cpath=$(container_path_for "$path" "$root")
  gpu_flags
  podman run --rm \
    "${GPU_FLAGS[@]}" \
    -v "${root}:/models:ro,z" \
    "$GUFO_IMAGE" \
    gufo prompt --model "$cpath" --prompt "$prompt" --max-tokens "$max_tokens"
}

cmd_refresh() {
  local target="${1:-}" n
  if [ -z "$target" ]; then
    n=$(podman ps --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}' | head -1)
    if [ -z "$n" ]; then
      die "no running gufo containers"
    fi
    target="$n"
  fi
  n=$(c_name "$target")
  require_container "$n"
  container_running "$n" || die "container '$n' is not running"

  local port id oldid
  port=$(container_host_port "$n")
  if [ -z "$port" ]; then
    die "container '$n' has no published port"
  fi
  id=$(served_model_id "$port") || true
  if [ -z "$id" ]; then
    die "model not ready yet on port $port"
  fi
  if [ ! -f "$PI_MODELS_JSON" ] || ! is_registered "$n"; then
    warn "provider '$n' is not registered in models.json (use: gufo run)"
    return 0
  fi
  oldid=$(jq -r --arg p "$n" '.providers[$p].models[0].id // empty' "$PI_MODELS_JSON")
  if [ "$oldid" = "$id" ]; then
    info "$n: already up to date ('$id')"
    return 0
  fi
  backup_models_json
  local tmp
  tmp=$(mktemp)
  jq --arg p "$n" --arg oldid "$oldid" --arg newid "$id" '
    .providers[$p].models |= map(if .id == $oldid then .id = $newid else . end)
  ' "$PI_MODELS_JSON" > "$tmp"
  mv "$tmp" "$PI_MODELS_JSON"
  ok "$n: model id updated '$oldid' -> '$id'"
}

cmd_unregister() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    die "usage: gufo unregister <model|name>"
  fi
  local prov
  prov=$(provider_name "$target")
  if [ ! -f "$PI_MODELS_JSON" ] || ! is_registered "$prov"; then
    die "provider '$prov' not in models.json"
  fi
  backup_models_json
  unregister_model "$prov"
  ok "removed provider '$prov' from $PI_MODELS_JSON"
}

cmd_diagnose() {
  gpu_flags
  podman run --rm "${GPU_FLAGS[@]}" "$GUFO_IMAGE" gufo diagnose
}

usage() {
  cat <<EOF
gufo — manage GGUF models via Gufo containers, hooked into pi-webui

usage: gufo <command> [args]

  models                          list available .gguf files
  run <model> [opts]              start model + register in pi models.json
      --port N                    host port (default: first free from $GUFO_PORT_START)
      --name slug                 container name (default: gufo-<model-slug>)
      --ctx N  --max N            context tokens (passed as -c to gufo) / maxTokens in models.json
      --ram-cache N               gufo CPU conversation-cache budget in bytes (default: 4 GiB)
                                  (defaults: $GUFO_CTX_DEFAULT / $GUFO_MAX_DEFAULT)
      --speculative MODE [GGUF]   draft backend: auto (default: mtp > dflash2 > dspark
                                  sidecar found in the model's dir, else AR), off,
                                  mtp, dflash2 or dspark; optional explicit sidecar path
      --draft-tokens N            speculative draft cap per step, 1-7 (default 7)
      --draft-policy POLICY       DFlash2 block policy: fixed or adaptive (default adaptive)
      --no-register               container only, skip models.json
      --image IMG                 runtime image (default: $GUFO_IMAGE)
  stop <model|name|all> [--keep-config]
                                  stop + remove container (and its provider)
  status                          containers, ports, model ids, registration
  logs [name] [--no-follow]       tail container logs
  prompt <model> "text" [opts]    one-shot generation (--max-tokens N)
  refresh [name]                  resync served model ids into models.json
  unregister <model|name>         remove provider from models.json only
  diagnose                        run gufo diagnose (GPU/toolchain check)

models dirs:   ${GUFO_MODELS_DIRS[*]}
models.json:   $PI_MODELS_JSON
EOF
}

# ------------------------------------------------------------------ main ----
cmd="${1:-help}"
if [ $# -gt 0 ]; then
  shift
fi
case "$cmd" in
  models)      cmd_models "$@" ;;
  run|start)   cmd_run "$@" ;;
  stop)        cmd_stop "$@" ;;
  status)      cmd_status "$@" ;;
  logs|log)    cmd_logs "$@" ;;
  prompt)      cmd_prompt "$@" ;;
  refresh)     cmd_refresh "$@" ;;
  unregister)  cmd_unregister "$@" ;;
  diagnose)    cmd_diagnose "$@" ;;
  help|-h|--help) usage ;;
  *)           printf '%s\n' "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
