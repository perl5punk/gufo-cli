#!/usr/bin/env bash
#
# gufo — manage local GGUF models through Gufo (Strix Halo inference engine)
#        and hook them into pi-webui via ~/.pi/agent/models.json.
#
# Every model runs in its own podman container from the gufo-runtime image,
# serving an OpenAI-compatible API on 127.0.0.1. When registered, a provider
# named "gufo-<model-slug>" is added to pi's models.json so pi-webui (and pi)
# can pick the model up immediately (the web server re-reads models.json on
# every request — no restart needed).
#
set -euo pipefail

# ---------------------------------------------------------------- config ----
GUFO_IMAGE="${GUFO_IMAGE:-ghcr.io/gufo-org/toolboxes/gufo-runtime:latest}"
GUFO_PORT_START="${GUFO_PORT_START:-13306}"      # auto-increments if busy
GUFO_MODELS_DIRS=(
  "${GUFO_MODELS_DIR:-$HOME/models}"
  "$HOME/.local/share/gufo/models"
)
PI_MODELS_JSON="${PI_MODELS_JSON:-$HOME/.pi/agent/models.json}"
GUFO_CTX_DEFAULT=131072
# CPU-side conversation-cache budget in bytes. Keep this well below the OS-side
# RAM pool: gufo's own default (half of free RAM, up to 32 GiB) OOM'd the host
# on this machine's 32 GiB system pool while loading a 30 GB model file.
GUFO_RAM_CACHE_DEFAULT=$((4 * 1024 * 1024 * 1024)) # 4 GiB
GUFO_MAX_DEFAULT=32768
# Parallel runs per model (gufo serve -j/--sessions). Sessions are real GPU
# request slots and -c is *per session*, so N sessions reserve N copies of the
# context: two 262k sessions left only single-digit GB of a 123 GB pool while a
# 111 GB model was resident. Keep the engine's default and raise it per model
# when the context is small enough to afford a second one.
GUFO_SESSIONS_DEFAULT="${GUFO_SESSIONS_DEFAULT:-1}"
WAIT_TIMEOUT=900                                  # max seconds to wait for model load
CONTAINER_PREFIX="gufo-"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_rst=$'\033[0m'
info() { printf '%s\n' "$*" >&2; }
ok()   { printf '%s\n' "${c_grn}$*${c_rst}" >&2; }
warn() { printf '%s\n' "${c_ylw}$*${c_rst}" >&2; }
die()  { printf '%s\n' "${c_red}error: $*${c_rst}" >&2; exit 1; }

# ------------------------------------------------------------ helpers -------
slugify() {
  local s
  s=$(basename "$1" | tr '[:upper:]' '[:lower:]' | sed 's/\.gguf$//')
  s=$(printf '%s' "$s" | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//')
  s=$(printf '%s' "$s" | sed 's/-[0-9][0-9]*-of-[0-9][0-9]*$//') # multi-shard suffix
  printf '%.48s' "$s"
}

resolve_model() {
  local query="$1" f d base hit lb ql
  if [ -f "$query" ]; then
    printf '%s\n' "$(realpath "$query")"
    return 0
  fi
  base=$(basename "$query"); base="${base,,}"
  ql="${query,,}"
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
      lb="${f##*/}"
      lb_n="${lb,,}"
      lb_n="${lb_n//_/-}"
      # draft sidecars and vision projectors are never serve targets (an MTP
      # "shared" sidecar e.g. has no token-embedding table at all)
      is_sidecar_name "$lb" && continue
      if [ "$lb_n" = "${base//_/-}" ] || [[ "$lb_n" == *"${ql//_/-}"* ]]; then
        printf '%s\n' "$f"
        return 0
      fi
    done < <(find "$d" -maxdepth 4 -iname '*.gguf' 2>/dev/null | sort) # deterministic shard order
  done
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    hit=$(find "$d" -maxdepth 4 -iname '*.gguf' \
            ! \( -iname 'mtp-*' -o -iname '*dflash*' -o -iname '*dspark*' -o -iname '*mmproj*' \) \
            -ipath "*$query*" 2>/dev/null | sort | head -1)   # keep in sync: is_sidecar_name
    if [ -n "$hit" ]; then
      printf '%s\n' "$hit"
      return 0
    fi
  done
  return 1
}

# Mount root: prefer the top-level models dir so /models mirrors the host tree
mount_root_for() {
  local path="$1" d
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    case "$path" in "$d"/*) printf '%s\n' "$d"; return 0 ;; esac
  done
  dirname "$path"
}

container_path_for() { # <path> <root> -> /models/<relative>
  local path="$1" root="$2"
  printf '/models/%s' "${path#"$root"/}"
}

# Model dir: nearest ancestor of <path> that is a direct child of a models dir
# (search boundary for draft sidecars, e.g. ~/models/qwen3.8-flash-next)
model_dir_for() {
  local path="$1" d rel
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    case "$path" in
      "$d"/*)
        rel="${path#"$d"/}"
        if [[ "$rel" == */* ]]; then
          printf '%s/%s' "$d" "${rel%%/*}"
        else
          printf '%s' "$d"
        fi
        return 0 ;;
    esac
  done
  dirname "$path"
}

# First GGUF under <dir> (maxdepth 3) matching one of the name patterns, skipping <target>
# GGUF key/value probe. The engine has no metadata command, so read the header
# directly. python3 is optional: without it the callers fall back to name
# heuristics. Prints the value of key "" (missing key -> no output).
gguf_key() { # <path> <key>
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$1" "$2" <<'PY' 2>/dev/null || true
import struct, sys

# GGUF v2/v3 header: magic, version, n_tensors, n_kv, then n_kv key/value pairs.
TYPES = {0: "B", 1: "b", 2: "H", 3: "h", 4: "I", 5: "i", 6: "f", 7: "?",
         10: "Q", 11: "q", 12: "d"}
STRING, ARRAY = 8, 9


def main() -> None:
    path, want = sys.argv[1], sys.argv[2]
    with open(path, "rb") as fh:
        blob = fh.read(4 * 1024 * 1024)      # general.architecture is always early
    if blob[:4] != b"GGUF" or struct.unpack_from("<I", blob, 4)[0] < 2:
        return
    n = struct.unpack_from("<Q", blob, 16)[0]
    if n > 100000:                            # implausible: mis-parse
        return
    off = 24

    def string(i):
        ln = struct.unpack_from("<Q", blob, i)[0]
        if ln > 64 * 1024 * 1024:
            raise ValueError("string too long")
        return blob[i + 8:i + 8 + ln].decode("utf-8", "replace"), i + 8 + ln

    for _ in range(n):
        key, off = string(off)
        kind = struct.unpack_from("<I", blob, off)[0]
        off += 4
        code = TYPES.get(kind)
        if code == "?":
            val = blob[off]; off += 1
        elif code is not None:
            size = struct.calcsize(code)
            val = struct.unpack_from(code, blob, off)[0]; off += size
        elif kind == STRING:
            val, off = string(off)
        elif kind == ARRAY:
            elem = struct.unpack_from("<I", blob, off)[0]; off += 4
            count = struct.unpack_from("<Q", blob, off)[0]; off += 8
            if count > 8000000:
                return
            if elem == STRING:
                for _ in range(count):               # token tables: walk, don't keep
                    _, off = string(off)
            else:
                e = TYPES.get(elem)
                if e is None:
                    return
                off += count * struct.calcsize(e)
        else:
            return                                   # unknown type: stop scanning
        if key == want:
            print(val)
            return


main()
PY
}

# Model families whose checkpoints answer in a thinking channel. Qwen3 and the
# qwen35/qwen4exp (Flash-Next) variants are hybrid-thinking by construction.
REASONING_ARCHS="qwen3 qwen35 qwen3next qwen4 qwen4exp qwq deepseek_r1 kimi_k2 minimax_m2"

is_reasoning_arch() { # <architecture> -> 0 when the family thinks
  local arch="${1,,}" a
  for a in $REASONING_ARCHS; do
    [ "$arch" = "$a" ] && return 0
  done
  return 1
}

# Draft and projector files are inputs to a model, never serve targets: an MTP
# "shared" sidecar has no token-embedding table, a vision projector no language
# weights at all. One predicate so `models`, resolution and the bridge agree.
is_sidecar_name() { # <path> -> 0 when the file is a draft or a projector
  local n="${1,,}"; n="${n//_/-}"
  case "$n" in mtp-*|*dflash*|*dspark*|*mmproj*) return 0 ;; esac
  return 1
}

# The engine auto-discovers a vision sidecar named exactly this, beside the
# model, and refuses image input otherwise ("image input requires a matching
# --mmproj BF16 sidecar"). Anything else has to be passed with --mmproj.
GUFO_MMPROJ_NAME="${GUFO_MMPROJ_NAME:-mmproj-BF16.gguf}"

# The projector to use for a model, if any: the conventional name wins, then any
# *mmproj*.gguf nearby (which only works because we pass it explicitly).
find_vision_projector() { # <model path> -> projector path or empty
  local dir parent
  dir=$(dirname "$1")
  [ -f "$dir/$GUFO_MMPROJ_NAME" ] && { printf '%s\n' "$dir/$GUFO_MMPROJ_NAME"; return 0; }
  find "$dir" -maxdepth 2 -iname "$GUFO_MMPROJ_NAME" 2>/dev/null | head -1
  find_sidecar "$dir" "$1" '*mmproj*.gguf' 2>/dev/null | head -1
}

# Capability guess from file names, used when GGUF metadata is unavailable.
name_suggests_reasoning() { # <model path or name>
  local n="${1,,}"
  case "$n" in
    *nothink*|*non-thinking*) return 1 ;;
  esac
  case "$n" in
    *qwen3*|*qwen4*|*qwq*|*r1*|*think*|*reason*) return 0 ;;
  esac
  return 1
}

# <auto|on|off> -> on/off, resolved from GGUF metadata (fallback: file name).
detect_reasoning() { # <model path> <mode>
  local mode="$2" arch
  case "$mode" in
    on)  printf 'on';  return 0 ;;
    off) printf 'off'; return 0 ;;
  esac
  arch=$(gguf_key "$1" general.architecture)
  if [ -n "$arch" ]; then
    is_reasoning_arch "$arch" && printf 'on' || printf 'off'
  else
    name_suggests_reasoning "$1" && printf 'on' || printf 'off'
  fi
}

# Vision is a property of the *served* model: the engine validates that the
# projector matches the checkpoint and rejects an image request otherwise. So a
# running container is the authority; a projector we are about to pass is the
# next best thing. A leftover or mismatched sidecar never advertises vision.
# Returns on|off|unknown. "unknown" means the container that serves this model
# did not answer - a busy engine is not evidence either way, and guessing from
# files there would advertise image input the server then refuses.
detect_vision() { # <model path> <mode auto|on|off> [port] [projector we attached]
  local mode="$2" port="${3:-}" projector="${4:-}" mods
  case "$mode" in
    on)  printf 'on';  return 0 ;;
    off) printf 'off'; return 0 ;;
  esac
  if [ -n "$port" ]; then
    mods=$(curl -fsS --max-time 5 "http://127.0.0.1:$port/v1/models" 2>/dev/null \
             | jq -r '.data[0].architecture.input_modalities[]?' 2>/dev/null | tr '\n' ' ')
    if [ -z "$mods" ]; then
      # No answer (or an engine that reports no modalities): only a projector we
      # attached ourselves justifies claiming vision.
      [ -n "$projector" ] && printf 'on' || printf 'unknown'
      return 0
    fi
    case "${mods,,}" in *image*) printf 'on'; return 0 ;; esac
    printf 'off'; return 0
  fi
  [ -n "$projector" ] && printf 'on' || printf 'off'
}

# Host path of the GGUF a container serves (from its mount + serve args).
container_model_path() { # <name>
  local cpath root
  cpath=$(podman inspect -f '{{join .Config.Cmd " "}}' "$1" 2>/dev/null \
            | grep -oE -- '--model[ =][^ ]+' | sed -E 's/^--model[ =]?//' || true)
  [ -n "$cpath" ] || return 0
  root=$(podman inspect -f '{{range .Mounts}}{{if eq .Destination "/models"}}{{.Source}}{{end}}{{end}}' "$1" 2>/dev/null)
  [ -n "$root" ] && printf '%s%s\n' "$root" "${cpath#/models}" || printf '%s\n' "$cpath"
}

find_sidecar() {
  local dir="$1" target="$2" pat f
  shift 2
  for pat in "$@"; do
    while IFS= read -r f; do
      if [ "$f" != "$target" ]; then
        printf '%s\n' "$f"
        return 0
      fi
    done < <(find "$dir" -maxdepth 3 -type f -iname "$pat" 2>/dev/null | sort)
  done
  return 1
}

free_port() {
  local p=$1
  while ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}$"; do
    p=$((p + 1))
    if [ "$p" -gt $(( $1 + 64 )) ]; then
      return 1
    fi
  done
  printf '%s\n' "$p"
}

# Accepts a model query, a path, or an existing container name (refresh, stop
# and logs all take any of them) without prefixing twice.
c_name() {
  local s
  if [ -n "${1:-}" ] && podman inspect "$1" >/dev/null 2>&1; then
    printf '%s\n' "$1"
    return 0
  fi
  s=$(slugify "${1:-}")
  case "$s" in
    "$CONTAINER_PREFIX"*) printf '%s\n' "$s" ;;
    *)                    printf '%s%s\n' "$CONTAINER_PREFIX" "$s" ;;
  esac
}
provider_name() { printf '%s%s' "$CONTAINER_PREFIX" "$(slugify "$1")"; }

require_container() {
  podman inspect "$1" >/dev/null 2>&1 || die "container '$1' not found (see: gufo models / gufo status)"
}

# Parallel runs a container was started with (the engine defaults to 1).
container_sessions() { # <name>
  local s
  s=$(podman inspect -f '{{join .Config.Cmd " "}}' "$1" 2>/dev/null \
        | grep -oE -- '--sessions[ =][0-9]+' | grep -oE '[0-9]+' | head -1 || true)
  printf '%s\n' "${s:-1}"
}

container_running() {
  local st
  st=$(podman inspect -f '{{.State.Status}}' "$1" 2>/dev/null || echo missing)
  [ "$st" = "running" ]
}

# Port the container publishes on the host (podman port: "13307/tcp -> 127.0.0.1:13307")
container_host_port() {
  podman port "$1" 2>/dev/null | head -1 | awk -F'->' '{print $NF}' | grep -oE '[0-9]+$' || true
}

# Device passthrough + group access, per gufo-org docs (crun/runc-safe: numeric gids)
gpu_flags() {
  local kfd_gid dri_gid dev
  GPU_FLAGS=()
  kfd_gid=$(stat -c '%g' /dev/kfd 2>/dev/null || true)
  if [ -n "$kfd_gid" ]; then
    GPU_FLAGS+=(--device /dev/kfd --group-add "$kfd_gid")
  fi
  if [ -d /dev/dri ]; then
    GPU_FLAGS+=(--device /dev/dri)
    for dev in /dev/dri/renderD*; do
      [ -e "$dev" ] || continue
      dri_gid=$(stat -c '%g' "$dev")
      if [ "$dri_gid" != "$kfd_gid" ]; then
        GPU_FLAGS+=(--group-add "$dri_gid")
      fi
    done
  fi
  GPU_FLAGS+=(--ulimit memlock=-1)
}

# ------------------------------------------------------- tailscale serve ---
# Exposes the loopback API port on the tailnet via 'tailscale serve' (HTTPS
# with the node's MagicDNS cert). Changing serve config requires operator
# rights once: `sudo tailscale set --operator=$USER`.
ts_dns_name() {
  tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//'
}

# true if a serve handler currently proxies to local port <port>
# (matches http(s) targets on 127.0.0.1, localhost, or 0.0.0.0 — manual configs vary)
serve_has_port() {
  tailscale serve status --json 2>/dev/null \
    | jq -e --arg p "$1" \
      '[.Web[]?.Handlers[]?.Proxy?] | any(test("(127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):" + $p + "$"))' \
    >/dev/null 2>&1
}

serve_url() { # <port>
  local d
  d=$(ts_dns_name)
  if [ -n "$d" ]; then
    printf 'https://%s:%s/v1\n' "$d" "$1"
  else
    printf 'http://%s:%s/v1\n' "$(tailscale ip -4)" "$1"
  fi
}

serve_expose() { # <port>
  tailscale serve --bg --https="$1" "http://127.0.0.1:$1" >/dev/null 2>&1
}

# -------------------------------------------------------- models.json -------
require_models_json() {
  [ -f "$PI_MODELS_JSON" ] || die "models.json not found at $PI_MODELS_JSON"
  command -v jq >/dev/null || die "jq is required to edit models.json"
}

backup_models_json() {
  require_models_json
  cp -f "$PI_MODELS_JSON" "$PI_MODELS_JSON.bak"
}

# Capabilities matter: pi only offers thinking levels when `reasoning` is set,
# and only attaches images when `input` says the model takes them. A model
# registered without them looks text-only and non-thinking in the picker.
capabilities_json() { # <reasoning on|off> <vision on|off> -> jq filter fragment
  local reasoning="$1" vision="$2"
  # Normalise through jq so callers can compare the fragment verbatim.
  printf '{"reasoning": %s, "input": %s}' \
    "$([ "$reasoning" = on ] && echo true || echo false)" \
    "$([ "$vision" = on ] && echo '["text","image"]' || echo '["text"]')" | jq -c .
}

register_model() { # <provider> <baseUrl> <modelId> <displayName> <ctx> <max> [reasoning] [vision] [oldId]
  local prov="$1" base="$2" id="$3" name="$4" ctx="$5" max="$6" oldid="${9:-}"
  local caps
  caps=$(capabilities_json "${7:-off}" "${8:-off}")
  require_models_json
  backup_models_json
  local tmp
  tmp=$(mktemp)
  jq --arg p "$prov" --arg base "$base" --arg id "$id" --arg name "$name" \
     --argjson ctx "$ctx" --argjson max "$max" --arg oldid "$oldid" --argjson caps "$caps" '
    .providers[$p] = ((.providers[$p] // {models: []}) | {
      baseUrl: $base,
      api: "openai-completions",
      apiKey: "gufo-local",
      models: ((.models // []) | map(select(.id != $id and .id != $oldid)))
    })
    | .providers[$p].models += [{id: $id, name: $name, contextWindow: $ctx, maxTokens: $max} + $caps]
  ' "$PI_MODELS_JSON" > "$tmp"
  mv "$tmp" "$PI_MODELS_JSON"
}

unregister_model() { # <provider>
  require_models_json
  backup_models_json
  local tmp
  tmp=$(mktemp)
  jq --arg p "$1" 'del(.providers[$p])' "$PI_MODELS_JSON" > "$tmp"
  mv "$tmp" "$PI_MODELS_JSON"
}

is_registered() { # <provider>
  jq -e --arg p "$1" '.providers[$p] != null' "$PI_MODELS_JSON" >/dev/null 2>&1
}

# Canonical model id served by a running container (taken from GGUF metadata)
served_model_id() { # <port>
  curl -fsS --max-time 5 "http://127.0.0.1:$1/v1/models" 2>/dev/null | jq -r '.data[0].id // empty'
}

wait_ready() { # <name> <port>
  local name="$1" port="$2" t=0
  info "Waiting for model load (up to $((WAIT_TIMEOUT / 60)) min)..."
  while :; do
    if curl -fsS --max-time 5 "http://127.0.0.1:${port}/v1/models" >/dev/null 2>&1; then
      echo >&2
      return 0
    fi
    if ! container_running "$name"; then
      echo >&2
      warn "container exited during load — last log lines:"
      podman logs --tail 15 "$name" >&2 || true
      return 1
    fi
    t=$((t + 5))
    if [ "$t" -ge "$WAIT_TIMEOUT" ]; then
      echo >&2
      warn "timed out after ${WAIT_TIMEOUT}s — last log lines:"
      podman logs --tail 15 "$name" >&2 || true
      return 1
    fi
    printf '\r  loading... %ds   ' "$t" >&2
    sleep 5
  done
}

# --------------------------------------------------------------- commands ----
cmd_models() {
  local show_all=0 found=0 d f sidecars=0
  [ "${1:-}" = "--all" ] && show_all=1
  for d in "${GUFO_MODELS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
      if is_sidecar_name "$f"; then
        # Draft/projector files belong to a model; list them only on request.
        if [ "$show_all" = 1 ]; then
          printf '%-58s %8s  %s  [sidecar]\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)" "$f"
        else
          sidecars=$((sidecars + 1))
        fi
        continue
      fi
      found=1
      printf '%-58s %8s  %s\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)" "$f"
    done < <(find "$d" -maxdepth 4 -iname '*.gguf' 2>/dev/null | sort)
  done
  if [ "$found" != 1 ]; then
    warn "no .gguf models found in: ${GUFO_MODELS_DIRS[*]}"
  elif [ "$sidecars" -gt 0 ]; then
    info ""
    info "$sidecars sidecar file(s) hidden (drafts, vision projectors) - see: gufo models --all"
  fi
}

# The runtime container must open /dev/kfd and /dev/dri/renderD* directly. Rootless
# podman cannot carry the 'render' group across the user-namespace boundary, so on
# distros that ship these nodes 0660 root:render (Ubuntu/Pop!_OS defaults; Fedora
# ships 0666) every containerized load fails with "no ROCm-capable device" — or the
# misleading "weight upload staging allocation failed" — despite a healthy host.
device_access_probe() { # -q: silent unless failing
  local quiet="${1:-}" out rc n
  local miss=0
  for n in /dev/kfd /dev/dri/renderD*; do
    [ -e "$n" ] || { echo "ERROR: missing device node: $n" >&2; miss=1; }
  done
  if [ "$miss" = 1 ]; then
    echo "amdgpu/KFD not loaded? check: lsmod | grep amdgpu ; sudo dmesg | grep -iE 'amdgpu|kfd' | tail" >&2
    return 1
  fi
  if ! podman image inspect "$GUFO_IMAGE" >/dev/null 2>&1; then
    [ "$quiet" = "-q" ] || echo "note: runtime image not pulled yet; container probe skipped"
    return 0
  fi
  out=$(podman run --rm --device /dev/kfd --device /dev/dri "$GUFO_IMAGE" sh -c '
        rc=0
        for n in /dev/kfd /dev/dri/renderD*; do
          [ -e "$n" ] || continue
          if [ -r "$n" ] && [ -w "$n" ]; then echo "ok   $n"
          else echo "DENY $n"; rc=1; fi
        done
        exit $rc' 2>&1)
  rc=$?
  if [ "$rc" != 0 ]; then
    echo "ERROR: the runtime container cannot read/write the GPU device nodes:" >&2
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    echo >&2
    echo "Rootless podman cannot inherit 'render' group membership across the" >&2
    echo "user-namespace boundary. Make the nodes world-accessible (persistent):" >&2
    cat >&2 <<'FIX'
  sudo tee /etc/udev/rules.d/99-gpu-access.rules >/dev/null <<'RULES'
  KERNEL=="renderD[0-9]*", GROUP="render", MODE="0666"
  KERNEL=="kfd", GROUP="render", MODE="0666"
  RULES
  sudo udevadm control --reload && sudo udevadm trigger
FIX
    echo "(throwaway test, resets on reboot: sudo chmod 666 /dev/kfd /dev/dri/renderD*)" >&2
    return 1
  fi
  [ "$quiet" = "-q" ] || { printf '%s\n' "$out"; echo "gpu: container device access OK"; }
}

cmd_gpu() {
  echo "rootless podman: $(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)"
  echo "host device nodes:"
  local n ok=1
  for n in /dev/kfd /dev/dri/renderD*; do
    [ -e "$n" ] || { echo "  missing: $n"; ok=0; continue; }
    printf '  %s\n' "$(stat -c '%n  %A  %U:%G' "$n")"
  done
  [ "$ok" = 1 ] || echo "  (missing nodes: driver not loaded — see dmesg)" >&2
  device_access_probe
}

cmd_run() {
  local model_q="" port="" name="" image="$GUFO_IMAGE" register=1 skip_devcheck="${GUFO_SKIP_DEVICE_CHECK:-0}"
  local ctx=$GUFO_CTX_DEFAULT max=$GUFO_MAX_DEFAULT ram_cache=$GUFO_RAM_CACHE_DEFAULT
  local spec_mode=auto spec_path="" draft_tokens="" draft_policy=""
  local served_name="" api_key=""
  local sessions=$GUFO_SESSIONS_DEFAULT reasoning_mode=auto vision_mode=auto
  local mmproj_mode=auto
  local tailscale=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)        port="${2:-}"; shift 2 ;;
      --name)        name="${2:-}"; shift 2 ;;
      --image)       image="${2:-}"; shift 2 ;;
      --ctx)         ctx="${2:-}"; shift 2 ;;
      --max)         max="${2:-}"; shift 2 ;;
      --ram-cache)   ram_cache="${2:-}"; shift 2 ;;
      --speculative) spec_mode="${2:-}"; shift 2
                     if [ $# -gt 0 ] && [[ "$1" != -* ]]; then spec_path="$1"; shift; fi ;;
      --draft-tokens) draft_tokens="${2:-}"; shift 2 ;;
      --draft-policy) draft_policy="${2:-}"; shift 2 ;;
      --served-name|--served-model-name) served_name="${2:-}"; shift 2 ;;
      --api-key)     api_key="${2:-}"; shift 2 ;;
      --sessions|-j) sessions="${2:-}"; shift 2 ;;
      --reasoning)   reasoning_mode="${2:-}"; shift 2 ;;
      --vision)      vision_mode="${2:-}"; shift 2 ;;
      --mmproj)      mmproj_mode="${2:-}"; shift 2 ;;
      --no-register) register=0; shift ;;
      --skip-device-check) skip_devcheck=1; shift ;;
      --tailscale)   tailscale=1; shift ;;
      -h|--help)     usage; exit 0 ;;
      -*)            die "unknown option: $1" ;;
      *)
        if [ -n "$model_q" ]; then
          die "one model per run; got '$model_q' and '$1'"
        fi
        model_q="$1"; shift ;;
    esac
  done
  if [ -z "$model_q" ]; then
    die "usage: gufo run <model> [--port N] [--ctx N] [--max N] [--ram-cache BYTES] [--speculative MODE [sidecar.gguf]] [--served-name ID] [--api-key KEY] [--no-register]"
  fi
  if [[ ! "$spec_mode" =~ ^(auto|off|mtp|dflash2|dspark)$ ]]; then
    die "invalid --speculative '$spec_mode' (expected auto, off, mtp, dflash2 or dspark)"
  fi
  if [[ ! "$sessions" =~ ^[1-9][0-9]*$ ]]; then
    die "--sessions must be a positive integer (got '$sessions')"
  fi
  if [[ ! "$reasoning_mode" =~ ^(auto|on|off)$ ]]; then
    die "invalid --reasoning '$reasoning_mode' (expected auto, on or off)"
  fi
  if [[ ! "$vision_mode" =~ ^(auto|on|off)$ ]]; then
    die "invalid --vision '$vision_mode' (expected auto, on or off)"
  fi
  if [[ ! "$mmproj_mode" =~ ^(auto|off)$ ]] && [ ! -f "$mmproj_mode" ]; then
    die "--mmproj expects auto, off, or a projector file (got '$mmproj_mode')"
  fi
  command -v podman >/dev/null || die "podman not found in PATH"
  if [ "$tailscale" = 1 ]; then
    command -v tailscale >/dev/null || die "tailscale not found in PATH"
    tailscale ip -4 >/dev/null 2>&1 || die "tailscale is not up (tailscale status)"
  fi

  if [ "$skip_devcheck" != 1 ]; then
    device_access_probe -q || die "fix GPU device access above (gufo gpu), or re-run with --skip-device-check"
  fi

  local path
  path=$(resolve_model "$model_q") || die "model not found: $model_q (see: gufo models)"
  if [ -z "$name" ]; then
    name=$(c_name "$path")
  fi
  if [ -z "$port" ]; then
    port=$(free_port "$GUFO_PORT_START") || die "no free port found from $GUFO_PORT_START"
  fi
  if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"; then
    die "port $port is already in use"
  fi

  if container_running "$name"; then
    warn "container '$name' is already running (port $(container_host_port "$name"))."
    warn "Use 'gufo stop $name' first, or pick another name/port."
    exit 1
  fi
  podman rm -f "$name" >/dev/null 2>&1 || true

  local root cpath
  root=$(mount_root_for "$path")
  cpath=$(container_path_for "$path" "$root")

  # ------------------------------------------------ speculative sidecar ----
  # auto: enable the best available draft backend if a matching sidecar GGUF
  # sits in the model's dir (mtp-*.gguf > *dflash2*.gguf > *dspark*.gguf)
  local SPEC_ARGS=() sidecar="" mdir spec_label="off (AR)"
  mdir=$(model_dir_for "$path")
  pick_sidecar() { # <patterns...> -> sets sidecar (from --speculative PATH or discovery)
    if [ -n "$spec_path" ]; then
      [ -f "$spec_path" ] || die "draft sidecar not found: $spec_path"
      sidecar=$(realpath "$spec_path")
    else
      sidecar=$(find_sidecar "$mdir" "$path" "$@") || \
        die "no draft sidecar found in $mdir (patterns: $*); pass one explicitly: --speculative $spec_mode <sidecar.gguf>"
    fi
  }
  case "$spec_mode" in
    mtp)
      pick_sidecar 'mtp-*.gguf' '*mtp*.gguf'
      SPEC_ARGS+=(--speculative mtp --mtp-model "$(container_path_for "$sidecar" "$root")")
      spec_label="mtp"
      ;;
    dflash2)
      pick_sidecar '*dflash2*.gguf'
      SPEC_ARGS+=(--speculative dflash2 --dflash-model "$(container_path_for "$sidecar" "$root")")
      spec_label="dflash2"
      ;;
    dspark)
      pick_sidecar '*dspark*.gguf'
      SPEC_ARGS+=(--speculative dspark --dspark-model "$(container_path_for "$sidecar" "$root")")
      spec_label="dspark"
      ;;
    auto)
      if sidecar=$(find_sidecar "$mdir" "$path" 'mtp-*.gguf' '*mtp*.gguf'); then
        SPEC_ARGS+=(--speculative mtp --mtp-model "$(container_path_for "$sidecar" "$root")")
        spec_label="mtp (auto)"
      elif sidecar=$(find_sidecar "$mdir" "$path" '*dflash2*.gguf'); then
        SPEC_ARGS+=(--speculative dflash2 --dflash-model "$(container_path_for "$sidecar" "$root")")
        spec_label="dflash2 (auto)"
      elif sidecar=$(find_sidecar "$mdir" "$path" '*dspark*.gguf'); then
        SPEC_ARGS+=(--speculative dspark --dspark-model "$(container_path_for "$sidecar" "$root")")
        spec_label="dspark (auto)"
      else
        spec_label="off (no draft sidecar in $mdir)"
      fi
      ;;
    off) ;;
  esac
  if [ -n "$sidecar" ]; then
    case "$sidecar" in "$root"/*) : ;; *) die "draft sidecar must live under the mounted models root '$root': $sidecar" ;; esac
    spec_label="$spec_label: $sidecar"
  fi
  if [ -n "$draft_tokens" ]; then
    [[ "$draft_tokens" =~ ^[1-7]$ ]] || die "--draft-tokens must be 1-7"
    SPEC_ARGS+=(--draft-tokens "$draft_tokens")
  fi
  if [ -n "$draft_policy" ]; then
    [[ "$draft_policy" =~ ^(fixed|adaptive)$ ]] || die "--draft-policy must be fixed or adaptive"
    SPEC_ARGS+=(--draft-policy "$draft_policy")
  fi

  # Model identity + auth exposed by the container. Callers that publish these
  # endpoints elsewhere (lemonade-backend/gufo-lemonade) want a stable id rather
  # than whatever general.name the GGUF happens to carry.
  local SERVE_IDENTITY_ARGS=()
  if [ -n "$served_name" ]; then
    [[ "$served_name" =~ [[:space:]] ]] && die "--served-name must not contain whitespace"
    SERVE_IDENTITY_ARGS+=(--served-model-name "$served_name")
  fi
  if [ -n "$api_key" ]; then
    SERVE_IDENTITY_ARGS+=(--api-key "$api-key")
  fi

  # Vision projector. The engine auto-discovers exactly $GUFO_MMPROJ_NAME beside
  # the model and refuses image input otherwise, and it validates that the
  # projector belongs to this checkpoint. Passing the path we resolved removes
  # the guesswork (any name works); --mmproj off stops us wiring one in, though
  # the engine may still auto-load the conventional file if it sits there.
  local vision_path=""
  case "$mmproj_mode" in
    auto) vision_path=$(find_vision_projector "$path" || true) ;;
    off)  vision_path="" ;;
    *)    vision_path="$mmproj_mode" ;;
  esac
  local VISION_ARGS=()
  if [ -n "$vision_path" ]; then
    case "$vision_path" in
      "$root"/*) : ;;
      *) die "vision projector must live under the mounted models root '$root': $vision_path" ;;
    esac
    VISION_ARGS+=(--mmproj "$(container_path_for "$vision_path" "$root")")
    info "  vision: $vision_path"
  fi

  gpu_flags
  info "Starting $name"
  info "  model:  $path"
  info "  spec:   $spec_label"
  info "  image:  $image"
  info "  port:   127.0.0.1:$port"
  info "  runs:   $sessions parallel session(s)"
  [ -n "$served_name" ] && info "  id:     $served_name (served model name)"
  # A projector must never cost the model its service, so keep the launch
  # repeatable without it (the engine validates that a sidecar belongs to the
  # checkpoint and can refuse to load one that does not).
  launch_container() {
    podman run -d --name "$name" \
      "${GPU_FLAGS[@]}" \
      -v "${root}:/models:ro,z" \
      -p 127.0.0.1:${port}:${port} \
      "$image" \
      gufo serve llm --model "$cpath" --host 0.0.0.0 --port "$port" \
        -c "$ctx" --sessions "$sessions" --cache-ram-bytes "$ram_cache" \
        "${SPEC_ARGS[@]}" "${VISION_ARGS[@]}" "${SERVE_IDENTITY_ARGS[@]}" >/dev/null
  }

  launch_container || die "podman run failed"

  if ! wait_ready "$name" "$port"; then
    if [ "${#VISION_ARGS[@]}" -gt 0 ] &&
       podman logs "$name" 2>&1 | grep -qiE 'mmproj|vision sidecar|image input'; then
      warn "the engine rejected the vision projector ($(basename "$vision_path")); restarting text-only"
      podman rm -f "$name" >/dev/null 2>&1 || true
      VISION_ARGS=()
      vision_path=""
      launch_container || die "podman run failed (text-only retry)"
      wait_ready "$name" "$port" ||
        die "model failed to load (container left running: gufo logs $name)"
    else
      die "model failed to load (container left running: gufo logs $name)"
    fi
  fi

  local id
  id=$(served_model_id "$port") || true
  if [ -z "$id" ]; then
    die "could not read model id from http://127.0.0.1:$port/v1/models"
  fi
  ok "ready: model id '$id' on http://127.0.0.1:$port/v1"

  local reasoning vision
  reasoning=$(detect_reasoning "$path" "$reasoning_mode")
  vision=$(detect_vision "$path" "$vision_mode" "$port" "$vision_path")
  [ "$vision" = "unknown" ] && vision=$([ -n "$vision_path" ] && echo on || echo off)

  if [ "$register" = 1 ]; then
    local prov display
    prov=$(provider_name "$path")
    display="$(basename "$path" .gguf) (Gufo Local)"
    register_model "$prov" "http://127.0.0.1:${port}/v1" "$id" "$display" "$ctx" "$max" \
      "$reasoning" "$vision"
    ok "registered as provider '$prov' in $PI_MODELS_JSON (backup: .bak)"
    info "  caps:   reasoning=$reasoning vision=$vision (override: --reasoning/--vision)"
    info "pi-webui picks it up automatically — open the model picker in your browser."
  else
    info "skipped registration (--no-register)"
  fi

  if [ "$tailscale" = 1 ]; then
    if serve_expose "$port"; then
      ok "tailnet: $(serve_url "$port") — tailnet-only, no auth (gate with ACLs); removed on gufo stop"
    else
      warn "--tailscale: could not update tailscale serve config."
      warn "  one-time fix:  sudo tailscale set --operator=$USER"
      warn "  or manually:   sudo tailscale serve --bg --https=$port http://127.0.0.1:$port"
    fi
  fi
}

cmd_stop() {
  local target="${1:-}" keep_config=0
  if [ "${2:-}" = "--keep-config" ]; then
    keep_config=1
  fi
  if [ -z "$target" ]; then
    die "usage: gufo stop <model|name|all> [--keep-config]"
  fi

  local names=() n
  if [ "$target" = "all" ]; then
    while IFS= read -r n; do
      if [ -n "$n" ]; then
        names+=("$n")
      fi
    done < <(podman ps -a --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}')
  else
    local name
    if [ "${target:0:5}" = "gufo-" ]; then
      name="$target" # already a container name
    else
      name=$(c_name "$target")
    fi
    require_container "$name"
    names=("$name")
  fi
  if [ "${#names[@]}" -eq 0 ]; then
    warn "no gufo containers found"
    return 0
  fi

  for n in "${names[@]}"; do
    local tport
    tport=$(container_host_port "$n")
    podman stop -t 15 "$n" >/dev/null 2>&1 || true
    podman rm -f "$n" >/dev/null 2>&1 || true
    info "stopped + removed: $n"
    if [ -n "$tport" ] && command -v tailscale >/dev/null 2>&1 && serve_has_port "$tport"; then
      if tailscale serve --https="$tport" off >/dev/null 2>&1; then
        info "tailnet: removed serve entry for port $tport"
      else
        warn "could not remove tailnet serve entry for port $tport (try: sudo tailscale serve --https=$tport off)"
      fi
    fi
    if [ "$keep_config" != 1 ] && [ -f "$PI_MODELS_JSON" ] && is_registered "$n"; then
      unregister_model "$n"
      info "removed provider '$n' from models.json"
    fi
  done
}

cmd_status() {
  local any=0 n st port id
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    any=1
    st=$(podman inspect -f '{{.State.Status}}' "$n" 2>/dev/null || echo missing)
    printf '%s  %s\n' "$n" "$st"
    if [ "$st" = "running" ]; then
      port=$(container_host_port "$n")
      if [ -n "$port" ]; then
        printf '    port: http://127.0.0.1:%s/v1\n' "$port"
        printf '    runs: %s parallel\n' "$(container_sessions "$n")"
        id=$(served_model_id "$port") || true
        if [ -n "$id" ]; then
          printf '    model: %s\n' "$id"
        fi
        if command -v tailscale >/dev/null 2>&1 && serve_has_port "$port"; then
          printf '    tailnet: %s\n' "$(serve_url "$port")"
        fi
      fi
      if [ -f "$PI_MODELS_JSON" ] && is_registered "$n"; then
        # Keep this jq call on one line: a newline inside $( ) starts a new command.
        local caps
        caps=$(jq -r --arg p "$n" '.providers[$p].models[0] | "reasoning=\(.reasoning // false) input=\((.input // ["text"]) | join("+"))"' "$PI_MODELS_JSON" 2>/dev/null || true)
        printf '    registered in models.json: %syes%s (%s)\n' "$c_grn" "$c_rst" "$caps"
      else
        printf '    registered in models.json: %sno%s\n' "$c_ylw" "$c_rst"
      fi
    fi
  done < <(podman ps -a --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}' | sort)
  if [ "$any" != 1 ]; then
    info "no gufo containers found"
  fi
}

cmd_logs() {
  local target="${1:-}" follow=1
  if [ "${2:-}" = "--no-follow" ]; then
    follow=0
  fi
  if [ -z "$target" ]; then
    local n
    n=$(podman ps -a --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}' | head -1)
    if [ -z "$n" ]; then
      die "no gufo containers found"
    fi
    target="$n"
  fi
  local name
  name=$(c_name "$target")
  require_container "$name"
  if [ "$follow" = 1 ]; then
    exec podman logs -f --tail 100 "$name"
  fi
  podman logs --tail 100 "$name"
}

cmd_prompt() {
  local model_q="" prompt="" max_tokens=256
  while [ $# -gt 0 ]; do
    case "$1" in
      --max-tokens) max_tokens="${2:-}"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      *)
        if [ -n "$model_q" ] && [ -n "$prompt" ]; then
          die "unexpected argument: $1"
        fi
        if [ -z "$model_q" ]; then
          model_q="$1"
        else
          prompt="$1"
        fi
        shift ;;
    esac
  done
  if [ -z "$model_q" ] || [ -z "$prompt" ]; then
    die "usage: gufo prompt <model> \"prompt text\" [--max-tokens N]"
  fi
  local path root cpath
  path=$(resolve_model "$model_q") || die "model not found: $model_q"
  root=$(mount_root_for "$path")
  cpath=$(container_path_for "$path" "$root")
  gpu_flags
  podman run --rm \
    "${GPU_FLAGS[@]}" \
    -v "${root}:/models:ro,z" \
    "$GUFO_IMAGE" \
    gufo prompt --model "$cpath" --prompt "$prompt" --max-tokens "$max_tokens"
}

cmd_refresh() {
  local target="${1:-}" n
  if [ -z "$target" ]; then
    n=$(podman ps --filter "name=$CONTAINER_PREFIX" --format '{{.Names}}' | head -1)
    if [ -z "$n" ]; then
      die "no running gufo containers"
    fi
    target="$n"
  fi
  n=$(c_name "$target")
  require_container "$n"
  container_running "$n" || die "container '$n' is not running"

  local port id oldid
  port=$(container_host_port "$n")
  if [ -z "$port" ]; then
    die "container '$n' has no published port"
  fi
  id=$(served_model_id "$port") || true
  if [ -z "$id" ]; then
    die "model not ready yet on port $port"
  fi
  if [ ! -f "$PI_MODELS_JSON" ] || ! is_registered "$n"; then
    warn "provider '$n' is not registered in models.json (use: gufo run)"
    return 0
  fi
  # Re-detect what the model can do, so pi's thinking levels and image
  # attachments follow the model instead of whatever was written at first run.
  local path reasoning vision caps cur
  path=$(container_model_path "$n")
  # Keep whatever is registered when we cannot know better: a GGUF we cannot
  # read, or an engine too busy to answer, must not rewrite capabilities -
  # guessing "on" here would let pi attach images the server refuses.
  local keep_reasoning keep_vision
  keep_reasoning=$([ "$(jq -r --arg p "$n" '.providers[$p].models[0].reasoning // false' "$PI_MODELS_JSON")" = true ] && echo on || echo off)
  keep_vision=$([ "$(jq -r --arg p "$n" '(.providers[$p].models[0].input // ["text"]) | index("image") != null' "$PI_MODELS_JSON")" = true ] && echo on || echo off)

  if [ -n "$path" ] && [ -f "$path" ]; then
    reasoning=$(detect_reasoning "$path" auto)
    vision=$(detect_vision "$path" auto "$port")
  else
    reasoning="$keep_reasoning"
    vision="$keep_vision"
  fi
  if [ "$vision" = "unknown" ]; then
    vision="$keep_vision"
    warn "$n: server did not report modalities; keeping input as-is ('$vision')"
  fi
  caps=$(capabilities_json "$reasoning" "$vision")

  oldid=$(jq -r --arg p "$n" '.providers[$p].models[0].id // empty' "$PI_MODELS_JSON")
  cur=$(jq -c --arg p "$n" '.providers[$p].models[0]
              | {reasoning: (.reasoning // false), input: (.input // ["text"])}' "$PI_MODELS_JSON")
  if [ "$oldid" = "$id" ] && [ "$cur" = "$caps" ]; then
    info "$n: already up to date ('$id', $cur)"
    return 0
  fi
  backup_models_json
  local tmp
  tmp=$(mktemp)
  jq --arg p "$n" --arg oldid "$oldid" --arg newid "$id" --argjson caps "$caps" '
    .providers[$p].models |= map((if .id == $oldid then .id = $newid else . end) + $caps)
  ' "$PI_MODELS_JSON" > "$tmp"
  mv "$tmp" "$PI_MODELS_JSON"
  if [ "$oldid" != "$id" ]; then
    ok "$n: model id updated '$oldid' -> '$id'"
  fi
  if [ "$cur" != "$caps" ]; then
    ok "$n: capabilities updated $cur -> $caps"
  fi
}

cmd_unregister() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    die "usage: gufo unregister <model|name>"
  fi
  local prov
  prov=$(provider_name "$target")
  if [ ! -f "$PI_MODELS_JSON" ] || ! is_registered "$prov"; then
    die "provider '$prov' not in models.json"
  fi
  backup_models_json
  unregister_model "$prov"
  ok "removed provider '$prov' from $PI_MODELS_JSON"
}

cmd_diagnose() {
  gpu_flags
  podman run --rm "${GPU_FLAGS[@]}" "$GUFO_IMAGE" gufo diagnose
}

# Verified model recipes for gufo's speculative decoding. Files are fetched into
# the first models dir so `run --speculative auto` discovers the sidecars:
#   MTP sidecar   -> <model-dir>/MTP/mtp-*.gguf  (Flash-Next)
#   DFlash2 draft -> next to the 27B target GGUF (Qwen3.8-27B-GGUF/)
cmd_download() {
  local recipe="${1:-}"
  local hf_repo hf_rev dest min_free_gib
  case "$recipe" in
    flash-next)
      hf_repo="unsloth/Qwen3.8-Flash-Next-GGUF"
      hf_rev="38bb39ee97821de2c9009abb7e93950eec396e66"
      dest="${GUFO_MODELS_DIRS[0]}/qwen3.8-flash-next"
      min_free_gib=120
      ;;
    dflash2-27b)
      hf_repo="z-lab/Qwen3.8-27B-DFlash2-GGUF"
      hf_rev="2d9571f8ce46e151f61c6499c99dee6079e1d610"
      dest="${GUFO_MODELS_DIRS[0]}/Qwen3.8-27B-GGUF"
      min_free_gib=2
      ;;
    "")
      die "usage: gufo download <flash-next|dflash2-27b>"
      ;;
    *)
      die "unknown download recipe: $recipe (known: flash-next, dflash2-27b)"
      ;;
  esac

  command -v hf >/dev/null 2>&1 ||
    die "needs the 'hf' CLI (Hugging Face Hub CLI): https://huggingface.co/docs/huggingface_hub/guides/cli"

  local parent avail
  parent=$(dirname "$dest")
  avail=$(df -BG --output=avail "$parent" | tail -1 | tr -dc '0-9')
  (( avail >= min_free_gib )) ||
    die "need >= ${min_free_gib} GB free on $parent, have ${avail} GB"

  mkdir -p "$dest"
  # The xet transport stalls on some networks; classic HTTP with many workers resumes cleanly.
  export HF_HUB_DISABLE_XET=1

  # relpath:expected_bytes pairs, verified after download
  local -a expect
  case "$recipe" in
    flash-next)
      # --include takes ONE pattern; extra files go as positional args (no '--' separator,
      # which silently skips --local-dir placement).
      info "downloading $hf_repo UD-Q4_K_XL shards (~111 GB, resumable: rerun on failure)"
      hf download "$hf_repo" --revision "$hf_rev" \
        --include "UD-Q4_K_XL/*" --max-workers 16 --local-dir "$dest"
      info "downloading MTP sidecar (2.8 GB)"
      hf download "$hf_repo" --revision "$hf_rev" \
        "MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf" --local-dir "$dest"
      # Vision projector (0.9 GB). The --include pattern above only covers the quant
      # dir and the repo keeps the projector at its root, while find_vision_projector()
      # looks beside the shards - so fetch it by name into UD-Q4_K_XL/, under the
      # default $GUFO_MMPROJ_NAME and the same pinned revision. Without it the model
      # serves text perfectly and refuses every image with 400 "model does not support
      # image input", which reads like a pi bug rather than a missing file.
      info "downloading vision projector $GUFO_MMPROJ_NAME (0.9 GB) beside the shards"
      hf download "$hf_repo" --revision "$hf_rev" \
        "$GUFO_MMPROJ_NAME" --local-dir "$dest/UD-Q4_K_XL"
      expect=(
        "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf:10946624"
        "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00002-of-00004.gguf:49859583136"
        "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00003-of-00004.gguf:49376141504"
        "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00004-of-00004.gguf:12087983520"
        "MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf:2786568256"
      )
      # Verified only for the projector sizes we know; a renamed sidecar
      # (GUFO_MMPROJ_NAME pointing elsewhere) still downloads, unchecked.
      local mmproj_bytes=""
      case "$GUFO_MMPROJ_NAME" in
        mmproj-BF16.gguf) mmproj_bytes=907542944 ;;
        mmproj-F16.gguf)  mmproj_bytes=904004000 ;;
      esac
      [ -n "$mmproj_bytes" ] &&
        expect+=("UD-Q4_K_XL/$GUFO_MMPROJ_NAME:$mmproj_bytes")
      ;;
    dflash2-27b)
      info "downloading $hf_repo draft (1.1 GB)"
      hf download "$hf_repo" --revision "$hf_rev" \
        "Qwen3.8-27B-DFlash2-Q4_K_M.gguf" --local-dir "$dest"
      expect=("Qwen3.8-27B-DFlash2-Q4_K_M.gguf:1143006816")
      ;;
  esac

  local pair f got fail=0
  for pair in "${expect[@]}"; do
    f="${pair%:*}"
    got=$(stat -c %s "$dest/$f" 2>/dev/null || echo 0)
    if [ "$got" = "${pair#*:}" ]; then
      ok "OK   $f"
    else
      warn "BAD  $f (want ${pair#*:}, got $got)"; fail=1
    fi
  done
  (( fail == 0 )) || die "size verification failed under $dest"

  case "$recipe" in
    flash-next)  ok "ready: gufo run flash-next --ctx 32768  (stop other models first: 115 GB weights; it attaches the projector and registers input: [text, image])" ;;
    dflash2-27b) ok "ready: gufo run 27b  will now auto-enable DFlash2" ;;
  esac
}

usage() {
  cat <<EOF
gufo — manage GGUF models via Gufo containers, hooked into pi-webui

usage: gufo <command> [args]

  models [--all]                  list serve-able .gguf files (--all: also drafts
                                  and vision projectors, which are never models)
  gpu                             check GPU device nodes + container access (run after
                                  driver installs, OS upgrades, or on any load error)
  run <model> [opts]              start model + register in pi models.json
      --port N                    host port (default: first free from $GUFO_PORT_START)
      --name slug                 container name (default: gufo-<model-slug>)
      --ctx N  --max N            context tokens (passed as -c to gufo) / maxTokens in models.json
      --ram-cache N               gufo CPU conversation-cache budget in bytes (default: 4 GiB)
                                  (defaults: $GUFO_CTX_DEFAULT / $GUFO_MAX_DEFAULT)
      --speculative MODE [GGUF]   draft backend: auto (default: mtp > dflash2 > dspark
                                  sidecar found in the model's dir, else AR), off,
                                  mtp, dflash2 or dspark; optional explicit sidecar path
      --draft-tokens N            speculative draft cap per step, 1-7 (default 7)
      --draft-policy POLICY       DFlash2 block policy: fixed or adaptive (default adaptive)
      --served-name ID            model id exposed by the OpenAI API (default: the name
                                  baked into the GGUF); use a stable id when another app
                                  lists models and forwards requests back to us
      --api-key KEY               require this bearer key in the container
      --sessions N  (-j)          parallel runs per model (default: $GUFO_SESSIONS_DEFAULT = the engine
                                  default). Each session reserves its own -c context, so raise
                                  this only when there is memory for N contexts: it trades a
                                  little per-request speed for not queueing behind other clients
      --reasoning MODE            advertise a thinking channel to pi: auto (default: from
                                  GGUF architecture / file name), on or off
      --vision MODE               advertise image input: auto (default: from the running
                                  model, else the projector wired in below), on or off
      --mmproj PATH|auto|off      vision projector for this model (default: auto:
                                  $GUFO_MMPROJ_NAME beside the model, else any
                                  *mmproj*.gguf nearby). The engine only auto-discovers
                                  the conventional name and checks the projector belongs
                                  to the checkpoint, so a stale sidecar never enables
                                  vision on its own
      --no-register               container only, skip models.json
      --skip-device-check         don't verify container GPU device access before start
      --tailscale                 expose endpoint on the tailnet via 'tailscale serve'
                                  (https://<node>.<tailnet>.ts.net:<port>/v1; auto-cleaned on stop;
                                  needs operator rights once: sudo tailscale set --operator=$USER)
      --image IMG                 runtime image (default: $GUFO_IMAGE)
  stop <model|name|all> [--keep-config]
                                  stop + remove container (and its provider)
  status                          containers, ports, model ids, registration
  logs [name] [--no-follow]       tail container logs
  prompt <model> "text" [opts]    one-shot generation (--max-tokens N)
  refresh [name]                  resync served model id + capabilities into models.json
  unregister <model|name>         remove provider from models.json only
  diagnose                        run gufo diagnose (GPU/toolchain check)
  download <flash-next|dflash2-27b>
                                  fetch a verified model + its speculative sidecar from
                                  Hugging Face (needs the 'hf' CLI; resumable; checks free
                                  disk: flash-next ~120 GB, dflash2-27b ~1 GB)

models dirs:   ${GUFO_MODELS_DIRS[*]}
models.json:   $PI_MODELS_JSON
EOF
}

# ------------------------------------------------------------------ main ----
cmd="${1:-help}"
if [ $# -gt 0 ]; then
  shift
fi
case "$cmd" in
  models)      cmd_models "$@" ;;
  gpu)         cmd_gpu "$@" ;;
  run|start)   cmd_run "$@" ;;
  stop)        cmd_stop "$@" ;;
  status)      cmd_status "$@" ;;
  logs|log)    cmd_logs "$@" ;;
  prompt)      cmd_prompt "$@" ;;
  refresh)     cmd_refresh "$@" ;;
  unregister)  cmd_unregister "$@" ;;
  diagnose)    cmd_diagnose "$@" ;;
  download)    cmd_download "$@" ;;
  help|-h|--help) usage ;;
  *)           printf '%s\n' "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
